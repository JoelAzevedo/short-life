{
  "name": "short-life",
  "version": "1.0.0",
  "private": true,
  "description": "So Small, So Fast — an isometric low-poly story game about the shortness of life.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --minify --sourcemap --target=es2020 --outfile=dist/game.js",
    "watch": "esbuild src/main.js --bundle --format=iife --sourcemap --target=es2020 --outfile=dist/game.js --watch",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
